# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Configuration
# Leave MONGODB_URI empty (or set USE_IN_MEMORY_DB=true) to use an in-memory
# MongoDB for local development.
MONGODB_URI=mongodb://localhost:27017/healthcare-saas
DB_NAME=healthcare-saas

# JWT Configuration
JWT_SECRET=change_this_to_a_strong_secret_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Email token lifetimes (minutes)
EMAIL_VERIFICATION_EXPIRE_MIN=60
PASSWORD_RESET_EXPIRE_MIN=30

# Gmail SMTP (nodemailer) — delivers real emails to any inbox, no domain needed.
# GMAIL_PASS must be a Google "App Password", NOT your normal Gmail password:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-16-char-app-password
EMAIL_SENDER_NAME=MediTrack Healthcare

# Inventory expiry / low-stock alerts (node-cron + Nodemailer)
# ALERT_EMAIL_TO   — recipient of the daily digest; leave empty to disable the cron
# ALERT_EXPIRY_DAYS— flag lots expiring within this many days (default 90)
# ALERT_CRON       — cron expression for the digest (default daily at 08:00)
ALERT_EMAIL_TO=
ALERT_EXPIRY_DAYS=90
ALERT_CRON=0 8 * * *

# CORS Configuration
CORS_ORIGIN=http://localhost:5173